/* ===== Landing Hero ===== */

.landing-hero{
  position:relative;
  min-height:100vh;
  width:100%;
  padding:0;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  background:#06131b;
}



.landing-globe{
  position:absolute;
  inset:0;
  z-index:0;
  pointer-events:none;
  background:
    linear-gradient(to bottom, rgba(4,10,20,.05), rgba(4,10,20,.22)),
    url("/assets/images/afridigital-cinematic-hero.png") center bottom/cover no-repeat;
  filter:brightness(1.15) contrast(1.12) saturate(1.18);
}

.landing-globe::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle,rgba(255,255,255,.9) 1px,transparent 2px);
  background-size:140px 140px;
  opacity:.10;
}

.landing-globe::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(to bottom,transparent 45%,rgba(6,19,27,.35) 100%);
}


.landing-navigation{
  position:relative;
  z-index:20;
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:18px 24px;
}

.menu-button,
.notification-button,
.profile-button{
  width:44px;
  height:44px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.18);
  border-radius:14px;
  color:#fff;
  font-size:1.4rem;
}

.menu-button{
  flex:0 0 auto;
}

.landing-nav-brand{
  display:flex;
  align-items:center;
  gap:10px;
  margin-right:auto;
  margin-left:16px;
}

.brand-name{
  font-size:clamp(1.4rem,3vw,2rem);
  font-weight:900;
  color:#fff;
  white-space:nowrap;
}

.landing-nav-actions{
  display:flex;
  align-items:center;
  gap:12px;
}

.profile-container{
  position:relative;
}

.profile-menu{
  position:absolute;
  right:0;
  top:54px;
  min-width:220px;
  padding:14px;
  background:rgba(5,15,25,.95);
  border:1px solid rgba(255,255,255,.15);
  border-radius:16px;
  color:#fff;
}

.profile-menu div{
  padding:10px;
}

@media (max-width:768px){
