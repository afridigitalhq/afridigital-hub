/* ================================
   ECOSYSTEM MARQUEE
================================ */

.landing-shell {
  overflow-x: hidden;
}

.ecosystem-marquee {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  contain: layout paint;
  margin: 30px 0;
  border-radius: 18px;
  border: 1px solid rgba(0,255,204,0.2);
  background: rgba(255,255,255,0.05);
}

.ticker-track {
  display: flex;
  width: max-content;
  max-width: none;
  white-space: nowrap;
  padding: 16px 0;
  color: #67e8f9;
  font-weight: 600;
  will-change: transform;
  animation: ticker 28s linear infinite;
}

.ticker-item {
  display: inline-flex;
  align-items: center;
}

.ticker-dot {
  margin: 0 16px;
}

@keyframes ticker {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

/* ===== Premium AfriAI Landing Dock ===== */

.ai-panel{
margin:32px auto;
max-width:900px;
padding:24px;
border-radius:24px;
background:linear-gradient(180deg,#0d1b36,#091224);
border:1px solid rgba(0,255,180,.15);
box-shadow:0 20px 60px rgba(0,0,0,.35);
}

.afriai-status{
display:flex;
justify-content:space-between;
align-items:center;
font-weight:700;
margin-bottom:18px;
}

.afriai-status .online{
color:#22c55e;
}

.afriai-conversation{
min-height:180px;
padding:18px;
margin:18px 0;
border-radius:18px;
background:rgba(255,255,255,.04);
}

.ai-msg{
max-width:85%;
padding:14px 18px;
border-radius:18px;
background:#13325e;
line-height:1.6;
}

.afriai-actions{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:18px;
}

.afriai-actions button{
padding:10px 16px;
border:none;
border-radius:999px;
background:#173866;
color:#fff;
cursor:pointer;
}

.afriai-chat-row{
display:flex;
gap:12px;
align-items:center;
}

.afriai-input{
flex:1;
padding:16px;
border-radius:16px;
border:1px solid rgba(255,255,255,.12);
background:#111d36;
color:#fff;
outline:none;
}

.afriai-mic{
width:56px;
height:56px;
border:none;
border-radius:50%;
background:#14f1c5;
font-size:22px;
cursor:pointer;
}

@media (max-width:768px){
.ai-panel{margin:20px 16px;padding:18px;}
.ai-msg{max-width:100%;}
.afriai-chat-row{flex-direction:row;}
}


/* ================================
