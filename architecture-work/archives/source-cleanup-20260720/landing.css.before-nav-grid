  line-height:1.7;
}

.landing-footer button{
  width:max-content;
  padding:10px 18px;
  border:none;
  border-radius:12px;
  background:#1877F2;
  color:#fff;
  cursor:pointer;
  transition:.25s;
}

.landing-footer button:hover{
  transform:translateY(-2px);
  background:#0B5ED7;
}

@media(max-width:768px){
  .landing-footer{
    grid-template-columns:1fr;
    padding:32px 20px;
