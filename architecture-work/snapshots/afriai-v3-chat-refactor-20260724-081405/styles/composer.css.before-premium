.landing-afriai-composer{

  width:100%;

  display:flex;
  align-items:center;
  gap:10px;

}


.landing-afriai-composer input{

  flex:1;

  height:52px;

  padding:0 18px;

  border-radius:18px;

  border:1px solid var(--afri-primary-border);

  background:var(--afriglass-bg);

  color:inherit;

  outline:none;

  font-size:1rem;

}


.landing-afriai-composer input::placeholder{

  opacity:.65;

}


.landing-afriai-composer button{

  height:52px;

  padding:0 22px;

  border-radius:18px;

  border:none;

  background:var(--afri-primary);

  color:#001018;

  font-weight:700;

  cursor:pointer;

}
