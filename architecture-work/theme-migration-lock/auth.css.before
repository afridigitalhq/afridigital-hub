.auth-shell{
  min-height:100vh;
  background:#050b1a;
  color:#ffffff;
}

.auth-layout{
  display:grid;
  grid-template-columns:1fr 420px;
  gap:2rem;
  padding:3rem;
  align-items:center;
}

.auth-card{
  background:rgba(15,23,42,.72);
  border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(18px);
  border-radius:24px;
  padding:2rem;
  box-shadow:0 20px 60px rgba(0,0,0,.35);
}

.google-auth-button{
  width:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:.8rem;
  padding:14px;
  border-radius:14px;
  border:1px solid rgba(255,255,255,.15);
  background:#ffffff;
  color:#111827;
  font-weight:700;
  cursor:pointer;
}

.google-icon{
  font-weight:900;
}

.auth-divider{
  display:flex;
  align-items:center;
  gap:1rem;
  margin:1.5rem 0;
  opacity:.7;
}

.auth-form{
  display:flex;
  flex-direction:column;
  gap:1rem;
}

.auth-form input{
  padding:14px;
  border-radius:12px;
  border:1px solid rgba(255,255,255,.15);
  background:rgba(255,255,255,.06);
  color:white;
}

.auth-form button{
  padding:14px;
  border-radius:12px;
  border:none;
  background:#2563eb;
  color:white;
  font-weight:700;
}

.forgot-password-link{
  margin-top:1rem;
  background:none;
  border:none;
  color:#60a5fa;
  cursor:pointer;
}

.development-links{
  display:flex;
  justify-content:center;
  gap:1rem;
  margin-top:1.5rem;
}

.development-links a{
  color:#93c5fd;
  text-decoration:none;
}

@media(max-width:900px){
  .auth-layout{
    grid-template-columns:1fr;
    padding:1.5rem;
  }

  .auth-card{
    width:100%;
  }
}

.auth-hero{
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:48px;
  min-height:420px;
}

.auth-brand{
  display:flex;
  align-items:center;
  gap:16px;
  margin:30px 0 20px;
}

.auth-brand-mark{
  font-size:3rem;
}

.auth-subtitle{
  line-height:1.8;
  max-width:520px;
}

.auth-hero-badge{
  display:inline-flex;
  align-items:center;
  gap:10px;
}

.auth-status-dot{
  width:10px;
  height:10px;
  border-radius:50%;
}

