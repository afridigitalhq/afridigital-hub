{
  "component": "UniversalAfriAICommandBar",
  "version": "1.0.0",
  "status": "bootstrap",
  "mount": "global",
  "placement": {
    "default": "bottom-floating",
    "supported": [
      "bottom-floating",
      "bottom-fixed",
      "left-dock",
      "right-dock"
    ]
  },
  "ui": {
    "statusIndicator": true,
    "voiceButton": true,
    "textInput": true,
    "sendButton": true,
    "moduleBadge": true,
    "historyDrawer": true,
    "waveform": true,
    "expandCollapse": true
  },
  "runtime": {
    "pluginArchitecture": true,
    "moduleRegistry": true,
    "contextAware": true,
    "telemetry": true
  },
  "futureExtensions": [
    "camera",
    "notifications",
    "image-analysis",
    "video-analysis",
    "live-sports",
    "text-to-speech",
    "speech-to-text",
    "file-upload",
    "screen-sharing"
  ]
}
