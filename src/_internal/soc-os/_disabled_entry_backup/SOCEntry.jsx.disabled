// DEPRECATED - DO NOT USE
import React, { useState } from "react";
import SOCBootLoader from "../boot/SOCBootLoader";
import SOCDESKTOPShell from "../ui-shell/SOCDESKTOPShell";

export default function SOCEntry() {
  const [ready, setReady] = useState(false);

  if (!ready) {
    return <SOCBootLoader onFinish={() => setReady(true)} />;
  }

  return <SOCDESKTOPShell />;
}
