.landing-afriai-panel{
  width:min(920px,calc(100% - 40px));
  margin:-20px auto 50px;
  padding:30px;
  text-align:center;
  background:var(--afriglass-bg);
  border:1px solid var(--afriglass-border);
  border-radius:var(--afriglass-radius);
  backdrop-filter:blur(var(--afriglass-blur));
  -webkit-backdrop-filter:blur(var(--afriglass-blur));
  box-shadow:var(--afriglass-shadow);
  border-radius:32px;
  background:
    linear-gradient(
      145deg,
      rgba(24,119,242,.18),
      rgba(255,255,255,.06)
    );
  border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(20px);
  display:flex;
  flex-direction:column;
  gap:24px;
}

.landing-afriai-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.landing-afriai-brand{
  display:flex;
  align-items:center;
  gap:14px;
}

.landing-afriai-icon{
  font-size:2.5rem;
}

.landing-afriai-brand h2{
  margin:0;
  font-size:1.6rem;
}

.landing-afriai-brand p{
  margin:4px 0 0;
  opacity:.75;
}

.landing-afriai-status{
  padding:8px 14px;
  border-radius:999px;
  background:rgba(34,197,94,.15);
}

.landing-afriai-welcome{
  padding:20px;
  border-radius:22px;
  background:rgba(255,255,255,.05);
  text-align:center;
}

.landing-afriai-welcome h3{
  margin-top:0;
}

.landing-afriai-recommendations{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}

.landing-afriai-recommendations button{
  display:flex;
  align-items:center;
  gap:12px;
  padding:16px;
  border-radius:20px;
  border:1px solid rgba(255,255,255,.12);
  background:rgba(255,255,255,.06);
  cursor:pointer;
}

.landing-afriai-recommendations span{
  font-size:1.5rem;
}

.landing-afriai-recommendations strong,
.landing-afriai-recommendations small{
  display:block;
  text-align:left;
}

.landing-afriai-composer{
  display:flex;
  gap:12px;
}

.landing-afriai-input{
  flex:1;
  display:flex;
  gap:10px;
}

.landing-afriai-input input{
  flex:1;
  padding:15px 18px;
  border-radius:20px;
  border:1px solid rgba(255,255,255,.15);
  background:rgba(0,0,0,.15);
}

.landing-afriai-input button,
.landing-afriai-mic{
  border-radius:20px;
  padding:12px 18px;
  cursor:pointer;
}

.landing-afriai-mic{
  font-size:1.3rem;
}

@media(max-width:768px){
  .landing-afriai-recommendations{
    grid-template-columns:1fr;
  }

  .landing-afriai-header,
  .landing-afriai-composer{
    flex-direction:column;
  }
}

.landing-afriai-waveform{
  height:70px;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:8px;
  padding:12px 0;
}

.landing-afriai-waveform span{
  width:6px;
  height:22px;
  border-radius:999px;
  background:#00ffcc;
  animation:afriaiVoicePulse 1s ease-in-out infinite;
}

.landing-afriai-waveform span:nth-child(2){
  animation-delay:.1s;
}

.landing-afriai-waveform span:nth-child(3){
  animation-delay:.2s;
}

.landing-afriai-waveform span:nth-child(4){
  animation-delay:.3s;
}

.landing-afriai-waveform span:nth-child(5){
  animation-delay:.4s;
}

.landing-afriai-waveform span:nth-child(6){
  animation-delay:.5s;
}

.landing-afriai-waveform span:nth-child(7){
  animation-delay:.6s;
}

@keyframes afriaiVoicePulse{
  0%,100%{
    height:18px;
    opacity:.5;
  }

  50%{
    height:55px;
    opacity:1;
  }
}


.landing-afriai-mic{
  width:64px;
  height:64px;
  border-radius:50%;
  border:1px solid rgba(0,255,204,.35);
  background:
    radial-gradient(
      circle,
      rgba(0,255,204,.25),
      rgba(24,119,242,.25)
    );
  color:white;
  font-size:1.6rem;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  box-shadow:
    0 0 25px rgba(0,255,204,.25);
  transition:.3s ease;
}

.landing-afriai-mic:hover{
  transform:scale(1.08);
  box-shadow:
    0 0 40px rgba(0,255,204,.45);
}


.landing-afriai-panel{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
}

.landing-afriai-header,
.landing-afriai-welcome,
.landing-afriai-waveform,
.landing-afriai-recommendations,
.landing-afriai-composer{
  width:100%;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.landing-afriai-brand{
  justify-content:center;
}

.landing-afriai-recommendations{
  display:flex;
  flex-direction:column;
}

.landing-afriai-composer{
  display:flex;
}

