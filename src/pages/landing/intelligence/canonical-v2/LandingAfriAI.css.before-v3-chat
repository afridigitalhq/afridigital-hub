.landing-afriai-section{
  width:100%;
  box-sizing:border-box;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:10px 24px;
  position:relative;
  overflow:hidden;
}

.landing-afriai-card{
  width:100%;
  max-width:none;
  min-height:520px;
  margin:0 auto;
  box-sizing:border-box;
  padding:28px;
  display:flex;
  flex-direction:column;
  gap:26px;
  border-radius:28px;
  background:
linear-gradient(
  145deg,
  var(--afri-primary-soft),
  rgba(5,11,24,.88)
);
  border:1px solid var(--afri-primary-border);
  backdrop-filter:blur(var(--afriglass-blur));
  -webkit-backdrop-filter:blur(var(--afriglass-blur));
  box-shadow:var(--afriglass-shadow);
  position:relative;
}

.landing-afriai-topbar{
  width:100%;
  display:flex;
  align-items:center;
  gap:24px;
}

.landing-afriai-identity{
  flex:1;
}

.landing-afriai-identity h2{
  margin:0;
  display:flex;
  align-items:center;
  gap:10px;
  font-size:clamp(1.8rem,2.5vw,2.4rem);
  font-weight:700;
}

.landing-afriai-identity p{
  margin:6px 0 0;
  opacity:.78;
  font-size:.98rem;
}

.landing-afriai-actions{
  width:100%;
  margin-top:0;
}

.afriai-live-dot{
  width:12px;
  height:12px;
  border-radius:50%;
  background:#00ff66;
  box-shadow:0 0 14px #00ff66;
  animation:afriaiLivePulse 1.8s infinite;
}

@keyframes afriaiLivePulse{
  0%,100%{transform:scale(1);opacity:.7;}
  50%{transform:scale(1.35);opacity:1;}
}
