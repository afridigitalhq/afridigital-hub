.landing-afriai-conversation{
  width:100%;
  flex:1;
  min-height:380px;
  padding:32px;
  box-sizing:border-box;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  gap:22px;
  border-radius:24px;
  background:linear-gradient(145deg,var(--afri-primary-soft),rgba(5,11,24,.88));
  border:1px solid var(--afri-primary-border);
  overflow-y:auto;
}

.landing-afriai-conversation-empty{
  flex:1;
  justify-content:flex-start;
  text-align:center;
  padding-top:20px;
}

.landing-afriai-conversation-empty h3,
.landing-afriai-conversation-empty p{
  align-self:center;
}

.landing-afriai-conversation-empty h3{
  margin:0;
  font-size:1.6rem;
  font-weight:700;
}

.landing-afriai-conversation-empty p{
  max-width:620px;
  margin:0;
  opacity:.8;
  line-height:1.7;
}

.landing-afriai-suggestions{
  max-width:900px;
  width:100%;
  margin:20px auto 0;
  display:grid;
  align-self:center;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:14px;
  margin-top:18px;
}

.landing-afriai-suggestions button{
  width:100%;
  padding:14px 18px;
  min-height:56px;
  border:none;
  border-radius:18px;
  background:rgba(24,119,242,.10);
  border:1px solid rgba(255,255,255,.08);
  color:inherit;
  text-align:left;
  cursor:pointer;
  transition:.25s ease;
}

.landing-afriai-suggestions button:hover{
  transform:translateY(-2px);
  border-color:var(--afri-primary);
  background:rgba(255,255,255,.10);
}

.landing-afriai-message{
  max-width:80%;
  padding:14px 18px;
  border-radius:18px;
  background:var(--afriglass-bg);
  line-height:1.6;
}

.landing-afriai-message.user{
  align-self:flex-end;
}

.landing-afriai-message.assistant{
  align-self:flex-start;
}


@media (max-width:700px){
  .landing-afriai-suggestions{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}


.landing-afriai-conversation-empty h3{
  width:100%;
  white-space:nowrap;
  text-align:center;
  padding-top:20px;
  font-size:clamp(1.2rem,2.5vw,1.8rem);
}
